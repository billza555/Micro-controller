void Init()
{
	score = 0;
	state = STATE_MENU;
	bicycleAction = Stand;
	tim1 = 0;
	tim2 = 0;
	playerX = 1;
	playerY = 3;
	enemyIndex = 0;
	enemy[amountEnemy];
	enemyX[amountEnemy];
	enemyY[amountEnemy];
}

//check coolision with player
void CheckCollision(int i)
{
	if(enemyX[i] == playerX && enemyY[i] == playerY)
	{
		state = STATE_CRASH;
	}
}

//update enemy position
void UpdateEnemyPosition()
{
	for(int i = 0; i < amountEnemy; i++)
	{
		if(enemy[i] > 0)
		{
			enemyY[i] += 1;
			CheckCollision(i);
			if(enemyY[i] > 3)
			{
				enemy[i] = 0;
			}
		}
	}
}

// wait for input
void HandleInput()
{
    switch (state)
    {
        case STATE_MENU:
             if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_SET) //Start game
             {
                 state = STATE_RUNNING;
             }
            break;

        case STATE_RUNNING:
             if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_11) == GPIO_PIN_RESET) //Turn left
             {
            	 if(playerX > 0)
            	 {
            		 playerX--;
            	 }
             }
             if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_12) == GPIO_PIN_RESET) //Turn Right
             {
            	 if(playerX < 2)
            	 {
            		 playerX++;
            	 }
             }
             if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_13) == GPIO_PIN_RESET) //Jump
             {
                 bicycleAction = Jump;
             }
            break;

        case STATE_CRASH:
        	if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_SET) //go to main menu
        	{
        		state = STATE_MENU;
        	}
            break;

        default:
            break;
    }
}

// update bicycle position
void Update()
{
	if(tim1)
    switch (state)
    {
        case STATE_RUNNING:
        	score++;
            break;

        case STATE_CRASH:
            break;

        default:
            break;
    }
}

// show bicycle position
void Render()
{
	if(__HAL_UART_GET_FLAG(&huart3, UART_FLAG_TC) == SET)
	{
		char clear[] = "\033[2J\033[H";
		HAL_UART_Transmit(&huart3, (uint8_t*)clear, strlen(clear), HAL_MAX_DELAY);
		switch (state)
		{
        	case STATE_MENU:
        		char welcome[] = "Welcome To Bicycle Game\nPress Button to start";
        		HAL_UART_Transmit(&huart3, (uint8_t*)welcome, strlen(welcome), HAL_MAX_DELAY);
        		break;

        	case STATE_RUNNING || STATE_CRASH:
        		char road[50] = "";
        		sprintf(road, "...\n\r...\n\r...\n\r...\n\r\n\nScore : %d", score);
        		int characterPosition = playerX + (playerY * 5);
        		road[characterPosition] = '0';
        		HAL_UART_Transmit(&huart3, (uint8_t*)road, strlen(road), HAL_MAX_DELAY);
        		break;

        	default:
        		break;
		}
	}
}
