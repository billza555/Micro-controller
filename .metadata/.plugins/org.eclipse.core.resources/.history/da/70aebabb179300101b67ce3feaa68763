/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* Enable D-Cache---------------------------------------------------------*/
  SCB_EnableDCache();

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART3_UART_Init();
  MX_SPI5_Init();
  MX_TIM1_Init();
  MX_RNG_Init();
  /* USER CODE BEGIN 2 */
  ILI9341_Init();//initial driver setup to drive ili9341
  Display();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	HAL_Delay(20);
	if(TP_Touchpad_Pressed())
	{
	    uint16_t position_array[2];
	    if(TP_Read_Coordinates(position_array) == TOUCHPAD_DATA_OK)
	    {
	        uint16_t rawX = position_array[0];
	        uint16_t rawY = position_array[1];

	        uint16_t x_pos = (rawX * 320) / 4095;
	        uint16_t y_pos = (rawY * 240) / 4095;

	        y_pos = 240 - y_pos;

	        uint16_t radius = 15;
	        uint16_t cycleX = 20;

	        if((x_pos - cycleX)*(x_pos - cycleX) + (y_pos - red_position_y)*(y_pos - red_position_y) <= radius*radius)
	        {
	            UpdateColor(&red);
	        }
	        if((x_pos - cycleX)*(x_pos - cycleX) + (y_pos - green_position_y)*(y_pos - green_position_y) <= radius*radius)
	        {
	            UpdateColor(&green);
	        }
	        if((x_pos - cycleX)*(x_pos - cycleX) + (y_pos - blue_position_y)*(y_pos - blue_position_y) <= radius*radius)
	        {
	            UpdateColor(&blue);
	        }
	        ILI9341_Draw_Filled_Circle(x_pos, y_pos, 2, BLACK);
	    }
	}

  }
  /* USER CODE END 3 */
}

