uint16_t RGB565(uint8_t r, uint8_t g, uint8_t b) {
    return ((r & 0xF8) << 8) |
           ((g & 0xFC) << 3) |
           (b >> 3);
}
uint16_t LightenColor(uint16_t color, uint8_t percent)
{
    if (percent > 100) percent = 100;

    uint8_t r = (color >> 11) & 0x1F;
    uint8_t g = (color >> 5)  & 0x3F;
    uint8_t b =  color        & 0x1F;

    uint8_t rMax = 31;
    uint8_t gMax = 63;
    uint8_t bMax = 31;

    r = r + ((rMax - r) * percent) / 100;
    g = g + ((gMax - g) * percent) / 100;
    b = b + ((bMax - b) * percent) / 100;

    return (r << 11) | (g << 5) | b;
}
void ShowColor(uint16_t color, uint8_t amount, uint16_t position_y)
{
    ILI9341_Draw_Filled_Circle(20, position_y, 15, color);
    ILI9341_Draw_Rectangle(60, position_y - 10, 120, 20, LightenColor(color, 5));
    uint16_t filledWidth = (120 * amount) / 255;
    ILI9341_Draw_Rectangle(60, position_y - 10, filledWidth, 20, color);
    char buf[10];
    sprintf(buf, "%d %%", (amount * 100) / 255);
    ILI9341_Draw_Text(buf, 200, position_y, BLACK, 2, WHITE);
}

void Display()
{
	ILI9341_Fill_Screen(WHITE);
	//320 x 240 pixel
	ILI9341_Set_Rotation(SCREEN_HORIZONTAL_1);
	ILI9341_Draw_Text("27.1 C", 20, 20, BLACK, 2, WHITE);
	ILI9341_Draw_Filled_Circle(130, 30, 15, RGB565(red, green, blue));
	ILI9341_Draw_Text("55.6 %RH", 170, 20, BLACK, 2, WHITE);
	ShowColor(RED, red, red_position_y);
	ShowColor(GREEN, green, green_position_y);
	ShowColor(BLUE, blue, blue_position_y);
}
void UpdateColor(uint8_t *color)
{
	*color = (*color + (255 / 10)) % 255;
	Display();
}
